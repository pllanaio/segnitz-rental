# Application
NODE_ENV=production
DEPLOYMENT_ENV=production
BASE_URL=https://rental.example.com
PORT=3000
# Pflichtentscheidung anhand der Proxy-Topologie: 0 (direkt), geprüfte Hop-Zahl
# oder explizite IP/CIDR-Liste; kein pauschales true.
TRUST_PROXY=
# Pro Anwendungsprozess; globale Schranke zuerst, anschließend pro Client-IP.
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_GLOBAL_MAX=6000
HTTP_RATE_LIMIT_MAX=600
# /ready und /health teilen dieses Minutenbudget; /live bleibt unabhängig.
READINESS_RATE_LIMIT_MAX=120
BUSINESS_TIME_ZONE=Europe/Berlin
SESSION_SECRET=
ADMIN_SETUP_TOKEN=
# Freigegebene Betreibertexte: Versionen und erreichbare HTTPS-URLs oder lokale Pfade.
LEGAL_TERMS_VERSION=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_VERSION=
LEGAL_PRIVACY_URL=
LEGAL_OPERATOR_URL=

# Database
DB_HOST=db.example.internal
DB_PORT=3306
DB_USER=segnitz_runtime
DB_PW=
DB_NAME=segnitz_rental
# Optional separate bootstrap principal; leave both variables unset otherwise.
# DB_MIGRATION_USER=segnitz_migrator
# DB_MIGRATION_PW=provide-via-secret-storage

# Mollie
MOLLIE_API_KEY=
MOLLIE_TEST_MODE=0

# Microsoft Graph mail
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
GRAPH_MAIL_USER=orders@example.com
ORDER_BCC=orders@example.com
DISABLE_EMAILS=0
# Wartung: Versandaufträge bleiben pending; keine simulierte Zustellung.
MAIL_DELIVERY_PAUSED=0
GRAPH_REQUEST_TIMEOUT_MS=10000
MOLLIE_REQUEST_TIMEOUT_MS=15000

# Maintenance
DISABLE_PERIODIC_CLEANUP=0
CLEANUP_INTERVAL_MS=60000
DISABLE_PAYMENT_RECONCILIATION=0
PAYMENT_RECONCILIATION_BATCH_SIZE=10
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
# Alternative: vorhandenes Unterschriftsbild hochladen; erst nach Betreiberfreigabe.
SIGNATURE_IMAGE_UPLOAD_ENABLED=0

# Gemeinsames Budget einschließlich einer reservierten DB-Abbruchverbindung.
DB_CONNECTION_LIMIT=12
DB_QUEUE_LIMIT=50
DB_ACQUIRE_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=15000
DB_READINESS_TIMEOUT_MS=1500
DB_TLS=0
DB_TLS_CA_FILE=
