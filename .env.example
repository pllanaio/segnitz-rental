# Application
BASE_URL=https://rental.example.com
PORT=3000
BUSINESS_TIME_ZONE=Europe/Berlin
SESSION_SECRET=
ADMIN_SETUP_TOKEN=

# Database
DB_HOST=db.example.internal
DB_PORT=3306
DB_USER=segnitz_runtime
DB_PW=
DB_NAME=segnitz_rental

# Mollie
MOLLIE_API_KEY=
# 0 = echte Mollie API (test_ Schlüssel für Sandbox, live_ für Echtgeld).
# 1 = ausschließlich interne Offline-Simulation für automatisierte Tests.
MOLLIE_TEST_MODE=0
# Optional lokal; in Produktion öffentliche HTTPS-URL, niemals localhost.
MOLLIE_WEBHOOK_URL=
MOLLIE_BILLING_COUNTRY=DE
MOLLIE_RECONCILIATION_ENABLED=1

# Microsoft Graph mail
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
GRAPH_MAIL_USER=orders@example.com
ORDER_BCC=orders@example.com
DISABLE_EMAILS=0

# Customer-facing sender details on emails and PDF receipts.
RECEIPT_COMPANY_NAME=Segnitz Rental
RECEIPT_COMPANY_ADDRESS=

# Maintenance
DISABLE_PERIODIC_CLEANUP=0
CLEANUP_INTERVAL_MS=60000

# Optional: interne Hinweise auf Widerrufe/Stornierungen (Fallback: ORDER_BCC / GRAPH_MAIL_USER)
CONTRACT_REQUEST_EMAIL=
